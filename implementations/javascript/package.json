{
  "name": "@umitkavala/zeroc",
  "version": "1.0.0",
  "description": "Zeroc: High-Performance API Compression Protocol - JavaScript/TypeScript Implementation",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && vite build",
    "dev": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "compression",
    "protobuf",
    "zstd",
    "api",
    "performance",
    "typescript"
  ],
  "author": "Zeroc Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/umitkavala/compress.git",
    "directory": "implementations/javascript"
  },
  "bugs": {
    "url": "https://github.com/umitkavala/compress/issues"
  },
  "homepage": "https://github.com/umitkavala/compress/tree/main/implementations/javascript",
  "dependencies": {},
  "peerDependencies": {
    "fzstd": "^0.1.0"
  },
  "peerDependenciesMeta": {
    "fzstd": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "@vitest/coverage-v8": "^1.0.0",
    "eslint": "^8.54.0",
    "prettier": "^3.1.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
